<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Mosaiq — Fleet Report Dashboard</title>
<script>
__MOSAIQ_CHARTJS_INLINE__
</script>
<style>
  :root {
    color-scheme: light dark;
    --bg: #0b0f14;
    --panel: #121820;
    --panel-border: #22303c;
    --text: #e8edf2;
    --muted: #8fa1b3;
    --accent: #4fd1c5;
    --accent-2: #a78bfa;
    --accent-3: #f6ad55;
    /* Caps how wide the content column gets on a large monitor. Past roughly this
       width the charts stop gaining any readability and the eye has to travel too
       far between a row's first and last column. */
    --page-max: 1600px;
  }
  @media (prefers-color-scheme: light) {
    :root {
      --bg: #f4f6f8;
      --panel: #ffffff;
      --panel-border: #dde4ea;
      --text: #1a2330;
      --muted: #5c6b7a;
    }
  }
  * { box-sizing: border-box; }
  /* Every top-level band shares one centred column, so the filters, KPI tiles, charts
     and table all keep the same left and right edges. Centring any one band on its own
     would break that shared edge - the page background still runs full width. */
  header,
  .filters,
  .kpis,
  .charts,
  footer {
    max-width: var(--page-max);
    margin-left: auto;
    margin-right: auto;
  }
  body {
    margin: 0;
    font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
  }
  header {
    padding: 28px 32px 18px;
    border-bottom: 1px solid var(--panel-border);
  }
  header h1 {
    margin: 0 0 4px;
    font-size: 1.8rem;
    letter-spacing: 0.02em;
  }
  header h1 span { color: var(--accent); }
  header p { margin: 0; color: var(--muted); font-size: 0.95rem; }

  /* Grid rather than flex-wrap: with flex, a wrapped row starts below the tallest
     card of the previous row, which leaves a large dead gap once there are enough
     filter groups to wrap. Equal auto-fitting columns keep the cards uniform and
     let every group sit on one row at normal widths. */
  .filters {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 14px;
    padding: 18px 32px;
    border-bottom: 1px solid var(--panel-border);
    align-items: start;
  }
  .filter-group {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 10px;
    padding: 10px 14px;
    min-width: 0;
  }
  .filter-group h4 {
    margin: 0 0 8px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .filter-group label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    margin-bottom: 4px;
    cursor: pointer;
  }
  .filter-group input[type="date"],
  .filter-group input[type="text"] {
    background: transparent;
    border: 1px solid var(--panel-border);
    color: var(--text);
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 0.85rem;
    width: 100%;
  }
  .filter-group .checklist { max-height: 140px; overflow-y: auto; }
  /* The free-input filters share a full-width row below the checklists. Flex rather
     than more grid columns, so search absorbs the leftover width while the date card
     stays at its natural size on the right. */
  .filter-row-wide {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: start;
  }
  /* Wide enough to read a full deployment name back, but deliberately not
     stretched to the width of the page - a text box far longer than anything
     ever typed into it just looks broken. */
  #filter-group-search { flex: 0 1 420px; min-width: 0; }
  #filter-group-date { flex: 0 0 auto; }
  #filter-group-date label { justify-content: space-between; }
  /* Lives at the end of the lower filter row: it is a terminal action, not a filter,
     so it does not belong in the run of equal-weight cards above. */
  #reset-filters {
    align-self: center;
    flex: 0 0 auto;
    background: var(--accent);
    color: #04201c;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
    cursor: pointer;
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 14px;
    padding: 22px 32px 0;
  }
  .kpi {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 12px;
    padding: 16px 18px;
  }
  .kpi .value { font-size: 1.6rem; font-weight: 700; }
  .kpi .label { color: var(--muted); font-size: 0.8rem; margin-top: 2px; }

  .charts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
    gap: 18px;
    padding: 22px 32px;
  }
  .chart-card {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 12px;
    padding: 16px;
  }
  .chart-card h3 {
    margin: 0 0 10px;
    font-size: 0.95rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .chart-card h3 select {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--panel-border);
    border-radius: 6px;
    font-size: 0.75rem;
  }
  .chart-card canvas { max-height: 280px; }
  .chart-card.wide { grid-column: 1 / -1; }
  .scatter-controls { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .scatter-controls label { font-size: 0.75rem; font-weight: 400; display: flex; align-items: center; gap: 4px; white-space: nowrap; }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  th, td {
    text-align: left;
    padding: 8px 10px;
    border-bottom: 1px solid var(--panel-border);
    white-space: nowrap;
  }
  th.num, td.num { text-align: right; font-variant-numeric: tabular-nums; }
  th { cursor: pointer; color: var(--muted); user-select: none; }
  th:hover { color: var(--text); }
  .table-wrap { overflow-x: auto; }
  footer { padding: 18px 32px 40px; color: var(--muted); font-size: 0.8rem; }
</style>
</head>
<body>

<header>
  <h1>Mos<span>aiq</span></h1>
  <p>One page, every deployment: connectors, versions, modules, and hardware — sliced however you like.</p>
</header>

<div class="filters">
  <div class="filter-group">
    <h4>Major version</h4>
    <div class="checklist" id="filter-major-version"></div>
  </div>
  <div class="filter-group">
    <h4>Connectors</h4>
    <div class="checklist" id="filter-connectors"></div>
  </div>
  <div class="filter-group">
    <h4>Modules</h4>
    <div class="checklist" id="filter-modules"></div>
  </div>
  <div class="filter-group">
    <h4>Database</h4>
    <div class="checklist" id="filter-database"></div>
  </div>
  <div class="filter-group" id="filter-group-license">
    <h4>Licence</h4>
    <div class="checklist" id="filter-license"></div>
  </div>
  <!-- The two free-input filters get a row of their own below the checklists. Both
       read better wide than boxed into a narrow column, and keeping them together
       makes any wrapping predictable. They stay left-aligned with the cards above
       rather than spreading to the page edges, so the whole bar reads as one block
       of filters: search first because it is the primary action, then the date
       range beside it. -->
  <div class="filter-row-wide">
    <div class="filter-group" id="filter-group-search">
      <h4>Search</h4>
      <input type="text" id="filter-search" placeholder="Deployment name…" />
    </div>
    <div class="filter-group" id="filter-group-date">
      <h4>Report date</h4>
      <label>From <input type="date" id="filter-date-from" /></label>
      <label>To <input type="date" id="filter-date-to" /></label>
    </div>
    <button id="reset-filters">Reset filters</button>
  </div>
</div>

<div class="kpis" id="kpis"></div>

<div class="charts">
  <div class="chart-card">
    <h3>Connector adoption</h3>
    <canvas id="chart-connectors"></canvas>
  </div>
  <div class="chart-card">
    <h3>Version distribution</h3>
    <canvas id="chart-versions"></canvas>
  </div>
  <div class="chart-card">
    <h3>Module adoption</h3>
    <canvas id="chart-modules"></canvas>
  </div>
  <div class="chart-card">
    <h3>Database type</h3>
    <canvas id="chart-database"></canvas>
  </div>
  <div class="chart-card">
    <h3>CPU cores distribution</h3>
    <canvas id="chart-cpu"></canvas>
  </div>
  <div class="chart-card">
    <h3>RAM (GB) distribution</h3>
    <canvas id="chart-ram"></canvas>
  </div>
  <div class="chart-card wide">
    <h3>
      Documents vs. hardware
      <span class="scatter-controls">
        <select id="scatter-x-metric">
          <option value="cpu_cores">X: CPU cores</option>
          <option value="ram_gb">X: RAM (GB)</option>
          <option value="index_size_gb">X: Disk/Index size (GB)</option>
        </select>
        <label><input type="checkbox" id="scatter-view-postgres" checked> PostgreSQL</label>
        <label><input type="checkbox" id="scatter-view-mssql" checked> MSSQL</label>
        <label><input type="checkbox" id="scatter-view-both"> Both</label>
      </span>
    </h3>
    <canvas id="chart-scatter"></canvas>
  </div>
</div>

<div class="charts" style="padding-top:0;">
  <div class="chart-card wide">
    <h3>All deployments</h3>
    <div class="table-wrap">
      <table id="data-table">
        <thead>
          <tr>
            <th data-key="deployment_name">Deployment</th>
            <th data-key="customer_id">Customer ID</th>
            <th data-key="report_date">Report date</th>
            <th data-key="product_version">Version</th>
            <th data-key="connectors">Connectors</th>
            <th data-key="modules">Modules</th>
            <th data-key="database_type">Database</th>
            <th data-key="license_status">Licence</th>
            <th data-key="cpu_cores" class="num">CPU cores</th>
            <th data-key="ram_gb" class="num">RAM (GB)</th>
            <th data-key="index_size_gb" class="num">Index (GB)</th>
            <th data-key="document_count" class="num">Documents</th>
          </tr>
        </thead>
        <tbody id="data-table-body"></tbody>
      </table>
    </div>
  </div>
</div>

<footer>Generated by Mosaiq on __MOSAIQ_GENERATED_AT__ — __MOSAIQ_DEPLOYMENT_COUNT__ deployment(s) parsed, __MOSAIQ_UNPARSED_COUNT__ unparsed.</footer>

<script>
const DEPLOYMENTS = __MOSAIQ_DATA_JSON__;
</script>
<script>
